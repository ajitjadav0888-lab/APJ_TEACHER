modules = ["nodejs-24", "python-base-3.13", "java-graalvm22.3", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = "python -m compileall -q apj_build/backend"
run = "cd apj_build/backend && exec python -m uvicorn app:app --host 0.0.0.0 --port $PORT"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["android-tools", "gradle", "libxcrypt", "apksigner"]
